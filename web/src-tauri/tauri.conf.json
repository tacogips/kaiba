{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kaiba",
  "version": "0.1.10",
  "identifier": "com.tacogips.kaiba",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kaiba",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Productivity",
    "shortDescription": "A native client for Kaiba note servers",
    "longDescription": "Read, search, and work with a Kaiba note server from macOS or iPhone.",
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "iOS": {
      "minimumSystemVersion": "17.0"
    }
  }
}
